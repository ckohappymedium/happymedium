---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section class="hero" style="color: white; text-align: center; padding: 100px 20px;">
    <h1>Welcome to Happy Medium</h1>
    <p>Experience the future of content creation.</p>
  </section>

<style>
  body {
    background-color: #333;
  }

  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    background-color: #333; /* Updated background color */
    color: #999; /* Updated text color */
  }
  
  .hero h1, .hero p {
    margin-bottom: 1rem;
    color: #999; /* Updated text color for h1 and p */
  }
</style>
</Layout>