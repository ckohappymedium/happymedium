---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section class="hero" style="background-color: #007BFF; color: white; text-align: center; padding: 100px 20px;">
    <h1>Welcome to Happy Medium</h1>
    <p>Experience the future of content creation.</p>
  </section>

<style>
.hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.hero h1, .hero p {
  margin-bottom: 1rem;
}

.hero h1, .hero p {
  margin-bottom: 1rem;
}
</style>
</Layout>